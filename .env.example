# RAILMARL Environment Variables Configuration Example
# Copy this file to .env and configure as needed.

# Database Configuration
DATABASE_URL=sqlite:///./railmarl.db
DEBUG=True
STATION_NAME="Itarsi Junction (ET)"
STATION_CODE=ET

# External Railway API Integration (Stage 7 & 9)
# Supported providers: railradar (preferred for Stage 9), rapidapi_irctc, mock_offline
RAILWAY_API_PROVIDER=railradar
RAILRADAR_API_KEY=your_railradar_api_key_here
RAILRADAR_BASE_URL=https://api.railradar.in/v1
RAILWAY_API_KEY=your_rapidapi_key_here
RAILWAY_API_HOST=indian-railway-irctc.p.rapidapi.com
RAILWAY_API_BASE_URL=https://indian-railway-irctc.p.rapidapi.com
RAILWAY_API_TIMEOUT=10
RAILWAY_API_CACHE_TTL_MINUTES=60
RAILWAY_API_ENABLE_OFFLINE_MOCK=True

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://localhost:3000
